#include <iostream>
#include <string>
#include <vector>
using namespace std;

int main() {
    int n;
    vector<string> nama, sekolah;

    cout << "Berapa data yang ingin diinput? ";
    cin >> n;
    cin.ignore();

    for (int i = 1; i <= n; i++) {
        string a, b;
        cout << "\nData ke-" << i << endl;
        cout << "Nama    : ";
        getline(cin, a);
        cout << "Sekolah : ";
        getline(cin, b);
        nama.push_back(a);
        sekolah.push_back(b);
    }

    cout << "\n=== Hasil Input ===\n";
    for (int i = 0; i < n; i++) {
        cout << i + 1 << ". " << nama[i]
             << " - " << sekolah[i] << endl;
    }
    return 0;
}
